---
/**
 * Página: /noticias
 *
 * PoC Astro vs Next.js
 * Esta página demuestra:
 * - Fetch de Supabase server-side
 * - SSR dinámico (prerender = false)
 * - Zero JavaScript by default
 */

// Astro v5: Para SSR, desactivar prerender
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { createServerClient } from '../lib/supabase';
import { mockNoticias } from '../lib/mock-data';
import { format } from 'date-fns';
import { es } from 'date-fns/locale';

// PoC: Usar mock data mientras resolvemos conectividad Supabase en WSL
const USE_MOCK_DATA = true;

let noticiasData: any[] = [];

if (USE_MOCK_DATA) {
  // Datos mock para demostración
  console.log('[PoC] Usando datos mock (conectividad Supabase pendiente)');
  noticiasData = mockNoticias;
} else {
  // Fetch noticias desde Supabase (server-side)
  const supabase = createServerClient();

  const { data: noticias, error } = await supabase
    .from('news_articles')
    .select('id, title, slug, excerpt, featured_image_url, published_at, category, etiquetas, views')
    .eq('status', 'published')
    .order('published_at', { ascending: false })
    .limit(20);

  if (error) {
    console.error('Error fetching noticias:', error);
  }

  noticiasData = noticias || [];
}
---

<BaseLayout
  title="Noticias y Análisis de ETFs"
  description="Últimas noticias, análisis y tendencias del mercado de ETFs. Mantente informado con nuestro equipo de expertos."
  ogImage="/og-images/noticias-og.png"
  canonical="/noticias"
>
  <main class="min-h-screen bg-gray-50">
    <!-- Header Simple -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
      <div class="container mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
          <a href="/" class="text-2xl font-bold text-primary">
            ETF Nexo
          </a>
          <nav class="hidden md:flex gap-6">
            <a href="/rankings" class="text-gray-700 hover:text-primary">Rankings</a>
            <a href="/noticias" class="text-primary font-semibold">Noticias</a>
            <a href="/academia" class="text-gray-700 hover:text-primary">Academia</a>
            <a href="/entrevistas" class="text-gray-700 hover:text-primary">Entrevistas</a>
          </nav>
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-primary to-primary-dark text-white py-16">
      <div class="container mx-auto px-4">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          Noticias y Análisis
        </h1>
        <p class="text-xl opacity-90">
          Mantente informado con las últimas tendencias del mercado de ETFs
        </p>
      </div>
    </section>

    <!-- Noticias Grid -->
    <section class="container mx-auto px-4 py-12">
      {noticiasData.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-gray-500 text-lg">No hay noticias publicadas</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {noticiasData.map((noticia) => (
            <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
              <!-- Featured Image -->
              {noticia.featured_image_url && (
                <a href={`/noticias/${noticia.slug}`}>
                  <img
                    src={noticia.featured_image_url}
                    alt={noticia.title}
                    class="w-full h-48 object-cover"
                    loading="lazy"
                  />
                </a>
              )}

              <!-- Content -->
              <div class="p-6">
                <!-- Category Badge -->
                {noticia.category && (
                  <span class="inline-block px-3 py-1 text-xs font-semibold text-primary bg-primary/10 rounded-full mb-3">
                    {noticia.category}
                  </span>
                )}

                <!-- Title -->
                <h2 class="text-xl font-bold mb-2 line-clamp-2">
                  <a href={`/noticias/${noticia.slug}`} class="hover:text-primary transition-colors">
                    {noticia.title}
                  </a>
                </h2>

                <!-- Excerpt -->
                {noticia.excerpt && (
                  <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                    {noticia.excerpt}
                  </p>
                )}

                <!-- Meta -->
                <div class="flex items-center justify-between text-xs text-gray-500">
                  <time datetime={noticia.published_at}>
                    {format(new Date(noticia.published_at), "d 'de' MMMM, yyyy", { locale: es })}
                  </time>
                  <span>{noticia.views || 0} vistas</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>

    <!-- Stats Footer -->
    <section class="bg-white py-8 mt-12 border-t">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <div>
            <div class="text-3xl font-bold text-primary">{noticiasData.length}</div>
            <div class="text-sm text-gray-600">Noticias Publicadas</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-primary">
              {noticiasData.reduce((sum, n) => sum + (n.views || 0), 0).toLocaleString()}
            </div>
            <div class="text-sm text-gray-600">Lecturas Totales</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-primary">
              {new Set(noticiasData.map(n => n.category).filter(Boolean)).size}
            </div>
            <div class="text-sm text-gray-600">Categorías</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-primary">Diario</div>
            <div class="text-sm text-gray-600">Actualizaciones</div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Utility classes para line-clamp (Tailwind v4) */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Custom color utilities */
  .text-primary {
    color: var(--color-primary);
  }

  .bg-primary {
    background-color: var(--color-primary);
  }

  .bg-primary\/10 {
    background-color: rgba(250, 128, 41, 0.1);
  }

  .from-primary {
    --tw-gradient-from: var(--color-primary);
  }

  .to-primary-dark {
    --tw-gradient-to: var(--color-primary-dark);
  }
</style>
