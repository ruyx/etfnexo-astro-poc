---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="ETF Nexo - Rankings y Análisis de ETFs"
  description="Descubre los mejores ETFs del mercado con análisis profesionales, rankings actualizados y herramientas de comparación."
>
  <Header />

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero__content" style="max-width: 900px; margin: 0 auto; text-align: center;">
        <h1 class="hero__title fade-in-up">
          Built for the way <span class="highlight">ETF investors</span> operate.
        </h1>
        <p class="hero__description fade-in-up" style="margin-left: auto; margin-right: auto; animation-delay: 0.1s;">
          Rankings actualizados, análisis independientes y herramientas profesionales para tomar mejores decisiones de inversión.
        </p>
        <div class="hero__cta fade-in-up" style="justify-content: center; animation-delay: 0.2s;">
          <a href="/rankings" class="btn btn-primary">Ver Rankings</a>
          <a href="/academia" class="btn btn-secondary btn-secondary--on-dark">Academia ETF</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section section--light">
    <div class="container">
      <div style="text-align: center; margin-bottom: 4rem;">
        <h2 class="mb-4" style="color: var(--text-primary);">La plataforma completa para inversores en ETFs</h2>
        <p class="text-large" style="max-width: 700px; margin: 0 auto; color: var(--text-secondary);">
          Todo lo que necesitas en un solo lugar
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
        <!-- Feature Card 1 -->
        <div class="card fade-in-up">
          <div style="width: 48px; height: 48px; background: var(--bg-light); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary);">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
          <h3 class="card__title" style="color: var(--text-primary);">Rankings actualizados</h3>
          <p class="card__description" style="color: var(--text-secondary);">
            Rankings diarios con datos verificados y análisis objetivos de los mejores ETFs del mercado.
          </p>
        </div>

        <!-- Feature Card 2 -->
        <div class="card fade-in-up" style="animation-delay: 0.1s;">
          <div style="width: 48px; height: 48px; background: var(--bg-light); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary);">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </div>
          <h3 class="card__title">Análisis profesionales</h3>
          <p class="card__description">
            Informes detallados sobre rentabilidad, riesgo, costes y liquidez de cada ETF.
          </p>
        </div>

        <!-- Feature Card 3 -->
        <div class="card fade-in-up" style="animation-delay: 0.2s;">
          <div style="width: 48px; height: 48px; background: var(--bg-light); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary);">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="card__title">Herramientas de comparación</h3>
          <p class="card__description">
            Compara ETFs lado a lado para tomar decisiones de inversión informadas.
          </p>
        </div>

        <!-- Feature Card 4 -->
        <div class="card fade-in-up" style="animation-delay: 0.3s;">
          <div style="width: 48px; height: 48px; background: var(--bg-light); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary);">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
          </div>
          <h3 class="card__title">Academia de ETFs</h3>
          <p class="card__description">
            Guías completas para aprender a invertir en ETFs desde cero hasta nivel avanzado.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section section--dark">
    <div class="container">
      <div style="text-align: center; max-width: 800px; margin: 0 auto;">
        <h2 class="mb-6" style="color: var(--text-white);">
          Comienza a invertir de forma <span class="highlight">inteligente</span>
        </h2>
        <p class="text-large mb-8" style="color: var(--text-light);">
          Únete a miles de inversores que ya utilizan ETF Nexo para tomar mejores decisiones
        </p>
        <div class="flex gap-4" style="justify-content: center; flex-wrap: wrap;">
          <a href="/rankings" class="btn btn-primary">Explorar Rankings</a>
          <a href="/academia" class="btn btn-secondary btn-secondary--on-dark">Ver Academia</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* Animaciones escalonadas */
  .fade-in-up:nth-child(2) {
    animation-delay: 0.1s;
  }

  .fade-in-up:nth-child(3) {
    animation-delay: 0.2s;
  }

  /* Hero content centering */
  .hero__content {
    position: relative;
    z-index: 2;
  }

  /* Grid responsive */
  @media (max-width: 767px) {
    .hero__cta {
      flex-direction: column;
      align-items: stretch;
    }

    .btn {
      width: 100%;
    }
  }
</style>
