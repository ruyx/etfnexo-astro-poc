":{"img_title":"F STREET","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1731931950/F-STREET/F-STREET.png?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1731931950/F-STREET/F-STREET.png?_i=AA","img_medium":"https://res.cloudinary.com/de1ep59a0/images/v1731931950/F-STREET/F-STREET.png?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1731931950/F-STREET/F-STREET.png?_i=AA","img_full":"https://res.cloudinary.com/de1ep59a0/images/v1731931950/F-STREET/F-STREET.png?_i=AA","img_alt":"F STREET"},"brand_logo":false,"testimonial_title":"","feedback":"\\"With Agora we were able to build a strong relationship with our investors. The transparency that the dashboard provides, where we can show them details of their investments, has been a game changer.\\"","video_type_group":{"video_type":"youtube","video_featured_image":{"img_title":"thumb (2)","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1733134943/thumb-2/thumb-2.jpg?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1733134943/thumb-2/thumb-2.jpg?_i=AA","img_medium":"https://res.cloudinary.com/de1ep59a0/images/v1733134943/thumb-2/thumb-2.jpg?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1733134943/thumb-2/thumb-2.jpg?_i=AA","img_full":"https://res.cloudinary.com/de1ep59a0/images/v1733134943/thumb-2/thumb-2.jpg?_i=AA","img_alt":""},"preview_video_file":"https://res.cloudinary.com/de1ep59a0/video/upload/v1735054822/FStreet-accelerates.mp4?_i=AA","video_file":false,"you_tube_video":"https://player.vimeo.com/video/1029309870"},"reviewer_name":"","reviewer_designation":"","testimonial_meta_list":false,"featured_image":{"img_title":"Website-2.0-Banner","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1731395998/Website-2.0-Banner/Website-2.0-Banner.png?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1731395998/Website-2.0-Banner/Website-2.0-Banner.png?_i=AA","img_