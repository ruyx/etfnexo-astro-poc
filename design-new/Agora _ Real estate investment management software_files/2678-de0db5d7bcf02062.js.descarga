rm-and-personalized-service","post_type":"case-study","acf":{"single_testimonial":{"testimonial_style":"Testimonial Style 1","testimonial_logo":{"img_title":"helu","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1731409781/helu/helu.webp?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1731409781/helu/helu.webp?_i=AA","img_medium":"https://res.cloudinary.com/de1ep59a0/images/v1731409781/helu/helu.webp?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1731409781/helu/helu.webp?_i=AA","img_full":"https://res.cloudinary.com/de1ep59a0/images/v1731409781/helu/helu.webp?_i=AA","img_alt":"helu logo"},"brand_logo":false,"testimonial_title":"","feedback":"\\"Immediately after starting with Agora, we tripled the amount of equity we were able to attract. We saved time on investor management, which enabled us to do more deals and focus on managing our assets.\\"","video_type_group":{"video_type":"youtube","video_featured_image":{"img_title":"thumb (3)","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1733135143/thumb-3/thumb-3.jpg?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1733135143/thumb-3/thumb-3.jpg?_i=AA","img_medium":"https://res.cloudinary.com/de1ep59a0/images/v1733135143/thumb-3/thumb-3.jpg?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1733135143/thumb-3/thumb-3.jpg?_i=AA","img_full":"https://res.cloudinary.com/de1ep59a0/images/v1733135143/thumb-3/thumb-3.jpg?_i=AA","img_alt":""},"preview_video_file":"https://res.cloudinary.com/de1ep59a0/video/upload/v1733156463/Helu-1_11999e1f67.mp4?_i=AA","video_file":false,"you_tube_video":"https://player.vimeo.com/video/1029308838"},"reviewer_name":"","reviewer_designation":"","testimonial_meta_list":false,"featured_image":{"img_title":"BG-banner-_-Helu-1-scaled","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1731396244/BG-banner-_-Helu-1-scaled-1/BG-banner-_-Helu-1-scaled-1.webp?_i=AA","image_sin