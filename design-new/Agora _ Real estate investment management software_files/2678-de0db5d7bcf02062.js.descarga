_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1733136025/asegewager/asegewager.png?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1733136025/asegewager/asegewager.png?_i=AA","img_medium":"https://res.cloudinary.com/de1ep59a0/images/v1733136025/asegewager/asegewager.png?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1733136025/asegewager/asegewager.png?_i=AA","img_full":"https://res.cloudinary.com/de1ep59a0/images/v1733136025/asegewager/asegewager.png?_i=AA","img_alt":""},"brand_logo":false,"testimonial_title":"","feedback":"\\"Agora really simplified the presentation for our investors. The investor portal presents our brand as a sophisticated brand with edgy marketing.”","video_type_group":{"video_type":"youtube","video_featured_image":{"img_title":"thumb (6)","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1733136143/thumb-6/thumb-6.jpg?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1733136143/thumb-6/thumb-6.jpg?_i=AA","img_medium":"https://res.cloudinary.com/de1ep59a0/images/v1733136143/thumb-6/thumb-6.jpg?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1733136143/thumb-6/thumb-6.jpg?_i=AA","img_full":"https://res.cloudinary.com/de1ep59a0/images/v1733136143/thumb-6/thumb-6.jpg?_i=AA","img_alt":""},"preview_video_file":"https://res.cloudinary.com/de1ep59a0/video/upload/v1733156468/lightwater-7_1200050206.mp4?_i=AA","video_file":false,"you_tube_video":"https://player.vimeo.com/video/1029308928"},"reviewer_name":"Meir Fried","reviewer_designation":"Co-Founder and CEO at Lightwater Capital Investments","testimonial_meta_list":false,"featured_image":{"img_title":"63204670623a6a61a5f4cd7b_Frame-47380.webp","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1731396362/63204670623a6a61a5f4cd7b_Frame-47380/63204670623a6a61a5f4cd7b_Frame-47380.webp?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1731396362/63