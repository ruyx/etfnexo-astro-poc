8/metonic-increased-investor-engagement_1500264e92_25360fbf49/metonic-increased-investor-engagement_1500264e92_25360fbf49.webp?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1781006068/metonic-increased-investor-engagement_1500264e92_25360fbf49/metonic-increased-investor-engagement_1500264e92_25360fbf49.webp?_i=AA","img_full":"https://res.cloudinary.com/de1ep59a0/images/v1781006068/metonic-increased-investor-engagement_1500264e92_25360fbf49/metonic-increased-investor-engagement_1500264e92_25360fbf49.webp?_i=AA","img_alt":""},"preview_video_file":"https://res.cloudinary.com/de1ep59a0/video/upload/v1733156477/metonic-11_120024a030.mp4?_i=AA","video_file":false,"you_tube_video":"https://player.vimeo.com/video/1029309028"},"reviewer_name":"Josh White","reviewer_designation":"VP of Investor Relations","testimonial_meta_list":false,"featured_image":{"img_title":"Metonic-banner-1973_1112-scaled","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1731396221/Metonic-banner-1973_1112-scaled-1/Metonic-banner-1973_1112-scaled-1.jpg?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1731396221/Metonic-banner-1973_1112-scaled-1/Metonic-banner-1973_1112-scaled-1.jpg?_i=AA","img_medium":"https://res.cloudinary.com/de1ep59a0/images/v1731396221/Metonic-banner-1973_1112-scaled-1/Metonic-banner-1973_1112-scaled-1.jpg?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1731396221/Metonic-banner-1973_1112-scaled-1/Metonic-banner-1973_1112-scaled-1.jpg?_i=AA","img_full":"https://res.cloudinary.com/de1ep59a0/images/v1731396221/Metonic-banner-1973_1112-scaled-1/Metonic-banner-1973_1112-scaled-1.jpg?_i=AA","img_alt":""}}}},{"ID":4801,"post_title":"Castle Lanterra saves tens of hours every month on investment operations","post_status":"publish","post_name":"castle-lanterra-streamlines-investment-operations","post_type":"case-study","acf":{"single_testimonial":{"testimonial_style":"Testimonial Style 1","testimonial_logo":{"img_title":"castle","img_thumb":"https://websiteapi.agorareal.com/wp-content/uploads/2024/10/castle.svg","image_single_post_thumb_url":"https://websiteapi.agorareal.com/wp-content/uploads/2024/10/castle.svg","img_medium":"https://websiteapi.agorareal.com/wp-content/uploads/2024/10/castle.svg","img_large":"https://websiteapi.agorareal.com/wp-content/uploads/2024/10/castle.svg","img_full":"https://websiteapi.agorareal.com/wp-content/uploads/2024/10/castle.svg","img_alt":"castle"},"brand_logo":false,"testimonial_title":"","feedback":"\\"I\'ve used a lot of CRMS over my career, and Agora\'s CRM is the most user-friendly that I\'ve seen.\\"","video_type_group":{"video_type":"mp4","video_featured_image":{"img_title":"Castle-banner-1973_1112-scaled","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1731396233/Castle-banner-1973_1112-scaled-1/Castle-banner-1973_1112-scaled-1.jpg?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1731396233/Castle-banner-1973_1112-scaled-1/Castle-banner-1973_1112-scaled-1.jpg?_i=AA","img_medium":"https://res.cloudinary.com/de1ep59a0/images/v1731396233/Castle-banner-1973_1112-scaled-1/Castle-banner-1973_1112-scaled-1.jpg?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1731396233/Castle-banner-1973_1112-scaled-1/Castle-banner-1973_1112-scaled-1.jpg?_i=AA","img_full":"https://res.cloudinary.com/de1ep59a0/images/v1731396233/Castle-banner-1973_1112-scaled-1/Castle-banner-1973_1112-scaled-1.jpg?_i=AA","img_alt":""},"preview_video_file":false,"video_file":false,"you_tube_video":""},"reviewer_name":"Lynn Glantz","reviewer_designation":"Head of Investor Relations & Marketing at Castle Lanterra","testimonial_meta_list":false,"featured_image":{"img_title":"Castle-banner-1973_1112-scaled","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1731396233/Castle-banner-1973_1112-scaled-1/Castle-banner-1973_1112-scaled-1.jpg?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0