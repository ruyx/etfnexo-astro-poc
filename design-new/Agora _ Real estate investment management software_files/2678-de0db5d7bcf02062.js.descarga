":"Testimonial Style 1","testimonial_logo":{"img_title":"Gelfand-logo","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1731396307/Gelfand-logo/Gelfand-logo.webp?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1731396307/Gelfand-logo/Gelfand-logo.webp?_i=AA","img_medium":"https://res.cloudinary.com/de1ep59a0/images/v1731396307/Gelfand-logo/Gelfand-logo.webp?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1731396307/Gelfand-logo/Gelfand-logo.webp?_i=AA","img_full":"https://res.cloudinary.com/de1ep59a0/images/v1731396307/Gelfand-logo/Gelfand-logo.webp?_i=AA","img_alt":"Gelfand"},"brand_logo":false,"testimonial_title":"","feedback":"\\"We couldn\'t be more satisfied with Agora\'s tax and bookkeeping services. We have managed to save a total of $90,000 this year on fees, while also improving efficiency,\\r\\noverall delivery and performance.\\"","video_type_group":{"video_type":"mp4","video_featured_image":false,"preview_video_file":false,"video_file":false,"you_tube_video":""},"reviewer_name":"Yonatan Gelfand Founder & CEO","reviewer_designation":"Gelfund Real Estate Opportunities Upgrade for More Features","testimonial_meta_list":false,"featured_image":{"img_title":"BG-banner-_-Gelfund-scaled","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1731396201/BG-banner-_-Gelfund-scaled-1/BG-banner-_-Gelfund-scaled-1.webp?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1731396201/BG-banner-_-Gelfund-scaled-1/BG-banner-_-Gelfund-scaled-1.webp?_i=AA","img_medium":"https://res.cloudinary.com/de1ep59a0/images/v1731396201/BG-banner-_-Gelfund-scaled-1/BG-banner-_-Gelfund-scaled-1.webp?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1731396201/BG-banner-_-Gelfund-scaled-1/BG-banner-_-Gelfund-scaled-1.webp?_i=AA","img_full":"https://res.cloudinary.com/de1ep59a0/images/v1731396201/BG-banner-_-Gelfund-scaled-1/BG-banner-_-Gelfund-scaled-1.webp?_i=AA","img_alt":""}}}},{"ID":4805,"post_title":"Providence Development reduced back office work while improving investor relations","post_status":"publish","post_name":"providence-enhances-investor-relations-with-agora","post_type":"case-study","acf":{"single_testimonial":{"testimonial_style":"Testimonial Style 1","testimonial_logo":{"img_title":"providence","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1731397884/providence/providence.webp?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1731397884/providence/providence.webp?_i=AA","img_medium":"https://res.cloudinary.com/de1ep59a0/images/v1731397884/providence/providence.webp?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1731397884/providence/providence.webp?_i=AA","img_full":"https://res.cloudinary.com/de1ep59a0/images/v1731397884/providence/providence.webp?_i=AA","img_alt":"providence"},"brand_logo":false,"testimonial_title":"","feedback":"\\"What used to take four days now takes one hour with Agora. the K-1 process is fully automated and secure, saving me significant time and ensuring investors can submit their K-1s on time. It\'s a win-win for everyone.\\"","video_type_group":{"video_type":"mp4","video_featured_image":false,"preview_video_file":false,"video_file":false,"you_tube_video":""},"reviewer_name":"Nicole Warwood CFO","reviewer_designation":"Providence Development","testimonial_meta_list":false,"featured_image":{"img_title":"BG-banner-_-Providence-scaled","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1731396210/BG-banner-_-Providence-scaled-1/BG-banner-_-Providence-scaled-1.webp?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1731396210/BG-banner-_-Providence-scaled-1/BG-banner-_-Providence-scaled-1.webp?_i=AA","img_medium":"https://res.cloudinary.com/de1ep59a0/images/v1731396210/BG-banner-_-Providence-scaled-1/BG-banner-_-Providence-scaled-1.webp?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1