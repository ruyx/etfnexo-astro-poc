estments","post_type":"case-study","acf":{"single_testimonial":{"testimonial_style":"Testimonial Style 1","testimonial_logo":{"img_title":"ydlp","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1733219655/ydlp/ydlp.png?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1733219655/ydlp/ydlp.png?_i=AA","img_medium":"https://res.cloudinary.com/de1ep59a0/images/v1733219655/ydlp/ydlp.png?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1733219655/ydlp/ydlp.png?_i=AA","img_full":"https://res.cloudinary.com/de1ep59a0/images/v1733219655/ydlp/ydlp.png?_i=AA","img_alt":""},"brand_logo":false,"testimonial_title":"","feedback":"\\"Anything that saves me three days of work, I like. I know the distribution notices will go out accurately and more professionally looking. YDLP is striving to comfortably make one new deal a month. it would be impossible to get to that point without Agora.”","video_type_group":{"video_type":"mp4","video_featured_image":false,"preview_video_file":false,"video_file":false,"you_tube_video":""},"reviewer_name":"Dovid Preil","reviewer_designation":"CEO & Founder at YDLP investments","testimonial_meta_list":false,"featured_image":{"img_title":"Frame-2960-min","img_thumb":"https://res.cloudinary.com/de1ep59a0/images/v1731396257/Frame-2960-min/Frame-2960-min.webp?_i=AA","image_single_post_thumb_url":"https://res.cloudinary.com/de1ep59a0/images/v1731396257/Frame-2960-min/Frame-2960-min.webp?_i=AA","img_medium":"https://res.cloudinary.com/de1ep59a0/images/v1731396257/Frame-2960-min/Frame-2960-min.webp?_i=AA","img_large":"https://res.cloudinary.com/de1ep59a0/images/v1731396257/Frame-2960-min/Frame-2960-min.webp?_i=AA","img_full":"https://res.cloudinary.com/de1ep59a0/images/v1731396257/Frame-2960-min/Frame-2960-min.webp?_i=AA","img_alt":""}}}}]')}}]);